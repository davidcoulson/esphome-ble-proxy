# Copy to /config/esphome/secrets.yaml and fill in. NEVER commit the real file.
# The repo .gitignore covers secrets.yaml and every secrets.yaml.* variant.

# --- network -----------------------------------------------------------------
wifi_ssid: "YourSSID"
wifi_password: "YourWiFiPassword"
wifi_captive: "fallback-ap-password"

# --- keys --------------------------------------------------------------------
# One shared OTA password is fine; API keys should be per-device in a real
# fleet. Generate a key with:  openssl rand -base64 32
ota_key: "your-ota-password"
api_key_ble_proxy: "base64-32-byte-key=="

# --- BLE identity resolving keys ---------------------------------------------
# One per phone/watch you want the proxies to forward. An advertisement from a
# resolvable private address that matches NONE of these is dropped on-device:
# it belongs to somebody else, it rotates, and it can never be tracked.
#
# Where to get them:
#   * Home Assistant: Settings > Devices > Private BLE Device - the IRK you
#     already entered there is the same value. This is the easiest source.
#   * config/common/irk-capture-base.yaml in this repo, flashed to a spare
#     ESP32/S2/S3 (NOT a C3/C6 - that component needs Bluedroid, not NimBLE).
#   * iOS: pair the phone to any ESP32 running irk-capture and read the IRK
#     entity it publishes.
#
# Format is a 32-character hex string. Delete the ones you don't have - an
# empty irks: list simply disables IRK filtering, it does not break anything.
ble_irk_phone_1: "00112233445566778899aabbccddeeff"
ble_irk_watch_1: "00112233445566778899aabbccddeeff"
ble_irk_phone_2: "00112233445566778899aabbccddeeff"
ble_irk_watch_2: "00112233445566778899aabbccddeeff"
ble_irk_phone_3: "00112233445566778899aabbccddeeff"
ble_irk_watch_3: "00112233445566778899aabbccddeeff"
ble_irk_phone_4: "00112233445566778899aabbccddeeff"
ble_irk_watch_4: "00112233445566778899aabbccddeeff"

# --- tracked tags ------------------------------------------------------------
# MACs that bypass EVERY filter including the RSSI threshold. This is where the
# tags you actually track go (pet tags, key fobs, Holy-IoT beacons). A weak
# reading from an allowlisted tag is exactly the measurement Bermuda needs to
# place it nearer another proxy, so it must not be dropped.
#
# A YAML list inside a secret - the whole list is substituted at
# `mac_allowlist: !secret ble_pet_tag_macs`.
ble_pet_tag_macs:
  - "AA:BB:CC:DD:EE:01"
  - "AA:BB:CC:DD:EE:02"
